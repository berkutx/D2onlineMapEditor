# Private voicer server-to-server integration only.
# Never send it to a browser. Generate with: openssl rand -hex 32
D2_INTEGRATION_SECRET=
# Keep off until the voicer migration has been verified.
VOICE_INTEGRATION_ENABLED=off
# Browser-visible nginx mount for login and project navigation in the private voicer.
VOICE_PUBLIC_BASE_PATH=/dialogeditor
# Optional comma-separated x-client-id pilot allowlist; empty means every browser.
VOICE_INTEGRATION_CLIENTS=

# External .sg previews: fixed lifetime and NEW unique uploads per originating IP/window.
PREVIEW_TTL_MS=3600000
PREVIEW_UPLOAD_LIMIT=5
PREVIEW_RATE_WINDOW_MS=3600000
