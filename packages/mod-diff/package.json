{
  "name": "@d2/mod-diff",
  "version": "0.1.0",
  "description": "The difference between two mods as a modder reads it: units, attacks, races, terrain, pictures, scripts, and every table op behind them",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@d2/dbf": "workspace:*",
    "@d2/mod-edit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  }
}
